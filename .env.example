# Dev-only settings. Copy to `.env` (git-ignored). Names only here — never commit values.
#
# DEV_MODE=true enables the dev key below. With DEV_MODE unset/false, the key is
# read ONLY from the OS credential store (Windows Credential Manager / macOS Keychain).
DEV_MODE=
ANTHROPIC_DEV_API_KEY=

# Optional: fixed port for development (default: pick a free port each launch).
MATHASSISTANT_PORT=

# Optional: don't auto-open the browser on launch.
MATHASSISTANT_NO_BROWSER=
